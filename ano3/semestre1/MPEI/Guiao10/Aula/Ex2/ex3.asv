% A, C, O, R, T, FIM

% b)
T = [ 0    7/30 0    7/30 7/30 0.3
      0.5  0    0.5  0    0    0
      0    7/30 0    7/30 7/30 0.3
      7/30 0    7/30 0    7/30 0.3
      0.5  0    0.5  0    0    0
      0    0    0    0    0    0]'

% c) simular geraçao de random palavra
% dar um inicial e function crawl fz o resto
% Possiveis iniciais -> A, C, O, R, T (5 opçoes)
r = randi(5);
% estado final é o 6 (FIM)
state1 = crawl(T, r, 6)
length(state1)-1
op = ['A', 'C', 'O', 'R', 'T']
word = [];
for i = 1:length(state1)-1
    word = [word op(state1(i))];
end
word

%% d) gerar 10^6 palavras e guarda-las num cell array
N = 100;
arr = cell(1, N);

for i = 1:N
    r = randi(5);
    state2 = crawl(T, r, 6);
    word = [];
    for j = 1:length(state2)-1
        word = [word op(state2(j))];
    end
    arr{i} = word;
end

%% e)  Prob palavra = 'TACO' -> 5, 1, 2, 3
count = 0;
N = 1e6;
for i = 1:N
    % começa no 5 para poder sair taco, 1a letra(T) -> 5
    state = crawl(T, 5, 6);

    if length(state) == 4
        if (state(1) == 5 && state(2) == 1 && state(3) == 2 && state(4) == 3)
            count = count + 1;
        end
    end
end

prob_taco = count/N

% f)
% Estados: T -> A -> C -> O -> FIM
T
P_TACO = T(1, 5) * T(2, 1) * T(3, 2) * T(6, 3);

disp("A probabilidade de formar 'TACO' é:")
disp(P_TACO)

%% g) com primento medio das palavras -> first = 'T'
count2 = 0;
N = 100;
soma = 0;

for i = 1:N
    state3 = crawl(T, 5, 6);

    if state(1) == 5
        count2 = count2 + 1;
        soma = soma + (length(state3) - 1);
    end
end
count2
soma
prob_media = soma/count2

