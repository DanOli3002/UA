% b)
% matriz H de hyperlinks
% igual prob para cada pag

H = zeros(N);
num = 0
for i = 1:N(1)
    % 1o contar quantos 1s existem por coluna
    num = sum(L(:, i));
    % 2o colunar prob 1/num nas posiçoes certas
    H(:, i) = L(:, i)/num;
end
H

