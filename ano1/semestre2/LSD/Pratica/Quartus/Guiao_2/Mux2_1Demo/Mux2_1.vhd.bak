library IEEE;
use IEEE.STD_LOGIC_1164.all;

entity Mux2_1Demo is 
	port(sel : std_logic;
			inputs : std_logic_vector(1 downto 0);
			output : std_logic;)
end Mux2_1Demo;

architecture comportamento of Mux2_1Demo is
begin
	process(sel, output)
	begin
		if (sel = '0') then
			output <= inputs(0);
		else
			output <= inputs(1);
		end if;
	end process;
end comportamento;