library IEEE;
use IEEE.STD_LOGIC_1164.all;

entity ProjF is
	port
	(
		CLOCK_50 : in    std_logic;
		SW       : in    std_logic;
		KEY      : in    std_logic_vector(2 downto 0);
		LEDG     : out   std_logic_vector(2 downto 0);
		LEDR     : out   std_logic;
		HEX0     : out   std_logic_vector(6 downto 0);
		Hex1     : out   std_logic_vector(6 downto 0);
		HEX4     : inout   std_logic_vector(6 downto 0)
	);
end ProjF_Demo;

architecture Shell of ProjF is

	signal s_clk_def, s_reset, s_start_stop, s_exp_time : std_logic;
	signal s_amassar, s_levedar, s_cozer, s_new_time    : std_logic_vector(5 downto 0);
	signal s_extra_time                                 : std_logic_vector(2 downto 0);
	signal display0, display1                           : std_logic_vector(3 downto 0);

begin

	s_clk_def    <= CLOCK_50;
	s_reset      <= not KEY(2);
	s_start_stop <= KEY(1);
	s_extra_time <= HEX4;
	
	Meu_Register : entity work.Register1(Behav)
	port map
	(
		rst            => s_reset,
		clk            => s_clk_def,
		P1_P2          => SW,
		Time_adj       => KEY(0),
		Start_stop     => Key(1),
		Extra_time     => s_extra_time,
		Cozer_time     => s_cozer,
		Levedar_time   => s_levedar,
		Amassar_time   => s_amassar,
		Start_stop_out => s_start_stop
	);
	
	Meu_FSM : entity work.FSM(Behav)
	port map
	(
		rst          => s_reset,
		clk          => s_clk_def,
		TExtra       => s_extra_time,
		Start_stop   => s_start_stop,
		Amassar_time => s_amassar,
		Levedar_time => s_levedar,
		Cozer_time   => s_cozer,
		New_time1    => s_new_time,
		Value_time   => s_new_time,
		LEDR         => LEDR,
		Amassar      => LEDG(0),
		Levedar      => LEDG(1),
		Cozer        => LEDG(2)
	);
	
	Meu_Timer_FSM : entity work.Timer_FSM(Behav)
	port map
	(
		clk          => s_clk_def,
		rst          => s_reset,
		Enable_timer => s_start_stop,
		New_time     => s_amassar,
		Value_time   => s_new_time,
		Exp_time     => s_exp_time
	);
	
	Meu_DivideTimer : entity work.DivideTimer(Behav)
	port map
	(
		Value_time => s_new_time,
		Enable_Timer => s_start_stop,
		Display0 => display0,
		Display1 => display1
	);
	
	Meu_Display_Select : entity work.Display_Select2(Behav)
	port map
	(
		input => display0,
		Enable_Timer => s_start_stop,
		segments => HEX0,
		Dec => HEX4
	);
	
	Meu_Display_Select : entity work.Display_Select2(Behav)
	port map
	(
		input => display1,
		Enable_Timer => s_start_stop,
		segments => HEX1,
		Dec => HEX4
	);
	
end Shell;
