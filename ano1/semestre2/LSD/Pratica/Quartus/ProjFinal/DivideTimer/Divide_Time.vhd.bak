library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity Divide_Time is
	port (
		Value_time  : in  std_logic_vector(5 downto 0);
		Enable_timer: in  std_logic;
		Display1    : out std_logic_vector(2 downto 0); -- Dígitos das dezenas
		Display0    : out std_logic_vector(2 downto 0); -- Dígitos das unidades
	);
end entity Divide_Time;

architecture Behav of Divide_Time is
	signal time_int                 : integer range 0 to 38; --número total máximo é 38
	signal dezenas_int, unidades_int: integer range 0 to 9;
begin
	process (Value_time, Enable_timer)
	begin
		if Enable_timer = '1' then
			-- Converter Value_time para inteiro
			time_int <= to_integer(unsigned(Value_time));

			-- Obter dígitos das dezenas e unidades
			dezenas_int <= time_int / 10;
			-- mob obtem resto da divisão
			unidades_int <= time_int mod 10;

			-- Converter dígitos para representação binária de 3 bits
			Display1 <= std_logic_vector(to_unsigned(dezenas_int, 3));
			Display0 <= std_logic_vector(to_unsigned(unidades_int, 3));
		else
			Display1 <= "000";         -- Desliga o dígito das dezenas
			Display0 <= "000";         -- Desliga o dígito das unidades
		end if;
	end process;
end architecture Behav;

