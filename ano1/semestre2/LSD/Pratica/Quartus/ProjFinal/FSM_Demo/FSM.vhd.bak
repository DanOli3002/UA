library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity FSM is
	port(
		Start_stop, clk, rst                        : in  std_logic;
		TExtra, Exp_time                            : in  std_logic_vector(2 downto 0);
		Cozer_time, Levedar_time, Amassar_time      : in  std_logic_vector(4 downto 0);
		New_time, Value_time                        : out std_logic_vector(2 downto 0);
		Enable_timer, Amassar, Levedar, Cozer, LEDR : out std_logic
	);
end FSM;

architecture Behav of FSM is

	type State_Type is (xIn, Amassar_state, Levedar_state, Cozer_state, Finish_state);
   signal Current_State, Next_State : State_Type;
	signal Amassar_Led, Levedar_Led, Cozer_Led : std_logic;
	
begin
	-- clk e reset do register
	process (Clk, rst)
	begin
		if rst = '1' then
			Current_State <= xIn;
			Next_State <= xIn;
			Amassar_Led <= '0';
			Levedar_Led <= '0';
			Cozer_Led <= '0';
      elsif rising_edge(Clock) then
			Current_State <= Next_State;
		end if;
	end process;
	
	-- estados
	process (Current_State, Start_stop)
	begin
		case Current_State is
			when xIn =>
				if Start_stop = '1' then
					Next_State <= Amassar_state;
					Amassar_Led <= '1';
					Levedar_Led <= '0';
					Cozer_Led <= '0';
				else
					Next_State <= xIn;
					Amassar_Led <= '0';
					Levedar_Led <= '0';
					Cozer_Led <= '0';
				end if;
			when Amassar_state =>
				Next_State <= Levedar_state;
				Amassar_Led <= '0';
					Levedar_Led <= '1';
					Cozer_Led <= '0';
			when Levedar_state =>
				Next_State <= Cozer_state;
				Amassar_Led <= '0';
				Levedar_Led <= '0';
				Cozer_Led <= '1';
			when Cozer_state =>
				Next_State <= Finish_state;
				Amassar_Led <= '0';
				Levedar_Led <= '0';
				Cozer_Led <= '1';
			when Finish_state =>
				Next_State <= xIn;
				Amassar_Led <= '0';
				Levedar_Led <= '0';
				Cozer_Led <= '0';
			when others =>
				Next_State <= xIn;
				Amassar_Led <= '0';
				Levedar_Led <= '0';
				Cozer_Led <= '0';
	   end case;
	end process;
	
	Amassar <= '1' when Current_State = Amassar_state else '0';
	Levedar <= '1' when Current_State = Levedar_state else '0';
	Cozer <= '1' when Current_State = Cozer_state else '0';
	Amassar <= Amassar_Led;
	Levedar <= Levedar_Led;
	Cozer <= Cozer_Led;
	LEDR <= '0' when Current_State = Finish_state else '1';
 
end Behav;