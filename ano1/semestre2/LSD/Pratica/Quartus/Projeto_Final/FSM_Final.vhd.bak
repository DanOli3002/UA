                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        load_enable <= '0';
                    END IF;
                WHEN ama =>
                    IF ((timeExp = '1')) THEN
                        reg_fstate <= lev;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= ama;
                    END IF;

                    IF ((pao = '0')) THEN
                        newTime <= "1010";
                    ELSIF ((pao = '1')) THEN
                        newTime <= "1111";
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        newTime <= "0000";
                    END IF;

                    enable <= staStop;

                    IF ((timeExp = '1')) THEN
                        load_enable <= '1';
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        load_enable <= '0';
                    END IF;
                WHEN lev =>
                    IF ((timeExp = '1')) THEN
                        reg_fstate <= coz;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= lev;
                    END IF;

                    IF ((pao = '0')) THEN
                        newTime <= "0100";
                    ELSIF ((pao = '1')) THEN
                        newTime <= "1000";
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        newTime <= "0000";
                    END IF;

                    enable <= staStop;

                    IF ((timeExp = '1')) THEN
                        load_enable <= '1';
                    -- Inserting 'else' block to prevent latch inference
