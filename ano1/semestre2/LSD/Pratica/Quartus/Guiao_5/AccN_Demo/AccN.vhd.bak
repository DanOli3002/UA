library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity AccN is
	generic (N : positive := 8);
	port(clk : in std_logic;
			enbale : in std_logic;
			reset : in std_logic;
			dataIn : in std_logic_vector((N-1) downto 0);
			dataOut : out std_logic_vector((N-1) downto 0));
end AccN;

architecture BehavioralAccN of AccN is
signal (s_adderout, s_regOut : std_logic_vector((N-1) downto 0);

adder_1 : entity WORK.AdderN(BehavioralAdderN)
				generic map(N => 8)
				port map(operand0 => dataIn,
							operand1 => s_regOut,
							s_adderOut => result);
							
reg_1 : entity WORK.RegN(BehavioralRegN)
				generic map(N => 8)
				port map(dataIn => s_adderOut,
							enable => enable,
							reset => reset,
							clk => clk,
							s_regOut => dataOut);
end BehavioralAccN;
							