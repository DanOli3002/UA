library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity ShiftRegister_Demo is
	generic(N : positive := 8;
				factor : positive := 50000000);
	port(sin : in std_logic;
			clk : in std_logic;
			dataOut : out std_logic_vector (N - 1 downto 0));
end ShiftRegiter_Demo;

architecture BehavioralShiftRegister_Demo of ShiftRegister_Demo is
signal clk2 : std_logic;
begin

	shift : entity WORK.ShiftRegisterN(BehavioralShiftRegisterN)
					generic map(size => N)
					port map(clk => clk,
								sin => sin,
								dataOut => dataOut);
								
	div : entity WORK.ClkDividerN(BehavioralClkDividerN)
					generic map(divFactor => factor)
					port map(clkIn => clk,
								clkOut => clk2);
end BehavioralShiftRegister_Demo;